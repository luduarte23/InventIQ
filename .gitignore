# ---------------------------------------------------------------
# InventIQ: Maven, Spring Boot, H2, IDEs y Claude Code
# (lo de arriba es la plantilla de Java con la que se creó el repositorio)
# ---------------------------------------------------------------

# Maven. La excepción del wrapper debe ir después de *.jar para que funcione.
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties

# Spring Boot
HELP.md
logs/

# Configuración local con secretos (p. ej. credenciales de Twilio en la Entrega 3).
# Nunca se versiona; documenta las variables en el README.
.env
.env.*
application-local.properties
application-local.yml

# Base de datos H2 embebida (se crea sola al arrancar)
data/
*.mv.db
*.trace.db
*.lock.db

